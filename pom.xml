<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>xerces</groupId>
  <artifactId>xercesImpl</artifactId>
  <version>2.12.2.11-bravura-11</version>
  <name>Xerces2 Java Parser</name>
  <description>Xerces2 provides high performance, fully compliant XML parsers in the Apache Xerces family. It builds on the Xerces Native Interface (XNI), a framework for building parser components and configurations. The Apache Xerces2 parser is the reference implementation of XNI. It provides conforming XML Schema 1.0 and 1.1 processors, a complete implementation of the Document Object Model Level 3 Core and Load/Save Recommendations, a complete implementation of the XML Inclusions (XInclude) Recommendation, and support for OASIS XML Catalogs v1.1. It parses documents written according to the XML 1.1 Recommendation and handles namespaces according to the XML Namespaces 1.1 Recommendation.</description>
  <url>https://github.com/martinhickson/xerces-j</url>

  <licenses>
    <license>
      <name>The Apache Software License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>martinhickson</id>
      <name>Martin Hickson</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/martinhickson/xerces-j.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/martinhickson/xerces-j.git</developerConnection>
    <url>https://github.com/martinhickson/xerces-j</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <impl.name>Xerces-J ${project.version}</impl.name>
    <impl.version>${project.version}</impl.version>
    <VERSION>Xerces-J ${project.version}</VERSION>
  </properties>

  <dependencies>
    <dependency>
      <groupId>xml-apis</groupId>
      <artifactId>xml-apis</artifactId>
      <version>1.4.01</version>
    </dependency>
    <dependency>
      <groupId>xml-resolver</groupId>
      <artifactId>xml-resolver</artifactId>
      <version>1.2</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${project.basedir}/src</sourceDirectory>
    <testSourceDirectory>${project.basedir}/tests</testSourceDirectory>

    <resources>
      <resource>
        <directory>${project.basedir}/src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
          <exclude>manifest.xerces</exclude>
          <!-- Service files are copied to META-INF/services. Ant does not also pack them at the source path. -->
          <exclude>org/apache/xerces/jaxp/javax.xml.parsers.DocumentBuilderFactory</exclude>
          <exclude>org/apache/xerces/jaxp/javax.xml.parsers.SAXParserFactory</exclude>
          <exclude>org/apache/xerces/jaxp/datatype/javax.xml.datatype.DatatypeFactory</exclude>
          <exclude>org/apache/xerces/jaxp/validation/javax.xml.validation.SchemaFactory</exclude>
          <exclude>org/apache/xerces/stax/javax.xml.stream.XMLEventFactory</exclude>
          <exclude>org/apache/xerces/parsers/org.xml.sax.driver</exclude>
          <exclude>org/apache/xerces/dom/org.w3c.dom.DOMImplementationSourceList</exclude>
          <exclude>org/apache/xerces/dom/org.apache.xerces.dom.DOMImplementationSourceImpl</exclude>
          <exclude>org/apache/xerces/parsers/org.apache.xerces.xni.parser.DTDConfiguration</exclude>
          <exclude>org/apache/xerces/parsers/org.apache.xerces.xni.parser.XML11Configuration</exclude>
          <exclude>org/apache/xerces/parsers/org.apache.xerces.xni.parser.XMLParserConfiguration</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>

    <testResources>
      <testResource>
        <directory>${project.basedir}/tests</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </testResource>
    </testResources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>filter-version-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-sources/version/org/apache/xerces/impl</outputDirectory>
              <delimiters>
                <delimiter>@@</delimiter>
              </delimiters>
              <useDefaultDelimiters>false</useDefaultDelimiters>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/org/apache/xerces/impl</directory>
                  <filtering>true</filtering>
                  <includes>
                    <include>Version.java</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>filter-manifest</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <delimiters>
                <delimiter>@</delimiter>
              </delimiters>
              <useDefaultDelimiters>false</useDefaultDelimiters>
              <resources>
                <resource>
                  <directory>${project.basedir}/src</directory>
                  <filtering>true</filtering>
                  <includes>
                    <include>manifest.xerces</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>jaxp-services</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF/services</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/org/apache/xerces/jaxp</directory>
                  <includes>
                    <include>javax.xml.parsers.DocumentBuilderFactory</include>
                    <include>javax.xml.parsers.SAXParserFactory</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/org/apache/xerces/jaxp/datatype</directory>
                  <includes>
                    <include>javax.xml.datatype.DatatypeFactory</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/org/apache/xerces/jaxp/validation</directory>
                  <includes>
                    <include>javax.xml.validation.SchemaFactory</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/org/apache/xerces/stax</directory>
                  <includes>
                    <include>javax.xml.stream.XMLEventFactory</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/org/apache/xerces/parsers</directory>
                  <includes>
                    <include>org.xml.sax.driver</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/org/apache/xerces/dom</directory>
                  <includes>
                    <include>org.w3c.dom.DOMImplementationSourceList</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.coderplus.maven.plugins</groupId>
        <artifactId>copy-rename-maven-plugin</artifactId>
        <version>1.0.1</version>
        <executions>
          <execution>
            <id>english-message-bundles</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/DOMMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/DOMMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/DatatypeMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/DatatypeMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/JAXPValidationMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/JAXPValidationMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/SAXMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/SAXMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/XIncludeMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/XIncludeMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/XMLMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/XMLMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/XMLSchemaMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/XMLSchemaMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/XMLSerializerMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/XMLSerializerMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/msg/XPointerMessages.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/msg/XPointerMessages_en.properties</destinationFile>
                </fileSet>
                <fileSet>
                  <sourceFile>${project.basedir}/src/org/apache/xerces/impl/xpath/regex/message.properties</sourceFile>
                  <destinationFile>${project.build.outputDirectory}/org/apache/xerces/impl/xpath/regex/message_en.properties</destinationFile>
                </fileSet>
              </fileSets>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-sample-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/samples</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <excludes>
            <exclude>org/apache/xerces/impl/Version.java</exclude>
            <exclude>org/w3c/dom/html/HTMLDOMImplementation.java</exclude>
          </excludes>
          <testExcludes>
            <testExclude>dom/rename/**</testExclude>
          </testExcludes>
        </configuration>
        <executions>
          <execution>
            <id>compile-filtered-version</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.build.directory}/generated-sources/version</compileSourceRoot>
              </compileSourceRoots>
              <excludes combine.self="override"/>
            </configuration>
          </execution>
          <execution>
            <id>compile-html-dom-implementation</id>
            <phase>compile</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <compileSourceRoots>
                <compileSourceRoot>${project.basedir}/src</compileSourceRoot>
              </compileSourceRoots>
              <includes>
                <include>org/w3c/dom/html/HTMLDOMImplementation.java</include>
              </includes>
              <excludes combine.self="override"/>
              <compilerArgs>
                <arg>--patch-module</arg>
                <arg>jdk.xml.dom=${project.basedir}/src</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestFile>${project.build.directory}/manifest.xerces</manifestFile>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useSystemClassLoader>true</useSystemClassLoader>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
          </includes>
          <excludes>
            <exclude>**/*AllTests.java</exclude>
            <exclude>**/schema/annotations/TestCase.java</exclude>
            <!-- Known failures in 2.12.2. Later Xerces leaves these out of the suite. -->
            <exclude>**/schema/config/IgnoreXSIType_C_AC_Test.java</exclude>
            <exclude>**/schema/config/IgnoreXSIType_C_CA_Test.java</exclude>
            <exclude>**/schema/config/IgnoreXSIType_C_C_Test.java</exclude>
            <exclude>**/schema/config/UseGrammarPoolOnly_True_Test.java</exclude>
            <exclude>**/schema/config/SurrogatePairLengthTest.java</exclude>
            <exclude>**/util/XercesAbstractTestCase.java</exclude>
            <exclude>**/jaxp/JAXPSpecTest.java</exclude>
            <exclude>**/jaxp/PropertyTest.java</exclude>
            <exclude>**/schema/Test.java</exclude>
            <exclude>**/dom/range/Test.java</exclude>
            <exclude>**/dom/registry/Test.java</exclude>
            <exclude>**/dom/ids/Test.java</exclude>
            <exclude>**/dom/dom3/Test.java</exclude>
            <exclude>**/dom/serialization/Test.java</exclude>
            <exclude>**/dom/mem/Test.java</exclude>
            <exclude>**/dom/events/Test.java</exclude>
            <exclude>**/dom/serialize/Test*.java</exclude>
            <exclude>**/dom/treewalker/Test*.java</exclude>
            <exclude>**/thread/Test.java</exclude>
            <exclude>**/xinclude/Test.java</exclude>
            <exclude>**/dom/DTest.java</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>surrogate-pair-length</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/schema/config/SurrogatePairLengthTest.java</include>
              </includes>
              <excludes combine.self="override"/>
              <systemPropertyVariables>
                <org.apache.xerces.impl.dv.xs.useCodePointCountForStringLength>true</org.apache.xerces.impl.dv.xs.useCodePointCountForStringLength>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>central-release</id>
      <!--
        The release workflow rewrites the groupId, then: mvn deploy -Pcentral-release
      -->
      <distributionManagement>
        <repository>
          <id>central</id>
          <url>https://central.sonatype.com/</url>
        </repository>
        <snapshotRepository>
          <id>central</id>
          <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
      </distributionManagement>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <waitMaxTime>7200</waitMaxTime>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
              <failOnError>false</failOnError>
              <failOnWarnings>false</failOnWarnings>
              <sourcepath>${project.basedir}/src</sourcepath>
            </configuration>
            <executions>
              <execution>
                <id>central-attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
